-...
+$ cd test
+$ python3 ../../../tools/pyboard.py -d /dev/ttyUSBX test_hello_world.py
+$ python3 ../../../tools/pyboard.py -d /dev/ttyUSBX test_machine.py
+$ etc...
 ```
